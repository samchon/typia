# Generated by `pnpm install` here. The sibling experiments keep their
# `package-lock.json` out of the repository the same way: these projects
# install freshly packed tarballs, so a pinned lockfile would only go stale.
pnpm-lock.yaml

# Scratch file the census pass writes beside this project so it resolves
# `typia` exactly as the consumer sources do. Removed on the way out; ignored
# so an interrupted run cannot leave it staged.
census.*.probe.ts
