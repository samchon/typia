{
  "name": "@typia/jev",
  "version": "15.0.0",
  "description": "Jev evaluation model integration for typia",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && rolldown -c",
    "dev": "ttsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/typia"
  },
  "author": "Jeongho Nam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samchon/typia/issues"
  },
  "homepage": "https://typia.io",
  "dependencies": {
    "@typia/interface": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "rolldown": "catalog:rolldown",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "tinyglobby": "^0.2.12"
  },
  "sideEffects": false,
  "files": [
    "README.md",
    "package.json",
    "lib",
    "src"
  ],
  "keywords": [
    "jev",
    "typesafe",
    "evaluation",
    "typia",
    "llm",
    "ai",
    "probability",
    "classification",
    "validation"
  ],
  "packageManager": "pnpm@10.6.4",
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.mjs",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
