{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ]
  },
  "files": [
    "entry.ts",
    "fixtures/node-buffer/node-buffer-augmentation.d.ts",
    "fixtures/node-buffer/user-ambient.d.ts",
    "fixtures/provided/globals.d.ts"
  ]
}
